Bootstrap: docker
From: rocker/rstudio:4.5.0

%labels
    Author      Mohamed Shoeb
    Version     1.0.0-r-only
    Description Bioinformatics container: RStudio Server + Quarto + R single-cell & pathway analysis
    R_Version   4.5.0
    Build_Date  2026-02-19

%help
    This container provides a reproducible R-based bioinformatics analysis environment:

    Services:
      - RStudio Server  (port 8787)  →  ./scripts/run_rstudio.sh
      - Interactive shell            →  ./scripts/run_shell.sh

    R packages (Bioconductor 3.22):
      Single-cell:  Seurat, SingleCellExperiment, scran, scater, slingshot, scDblFinder
      Pathway:      clusterProfiler, fgsea, GSVA, enrichplot, ReactomePA
      Workflow:     targets, tarchetypes, crew, quarto, rmarkdown
      Tidyverse:    tidyverse, ggplot2, patchwork, pheatmap, viridis, ...

%environment
    # Locale
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

    # R
    export RSTUDIO_WHICH_R=/usr/local/bin/R

    # Avoid tzdata prompt
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    # ---------------------------------------------------------------
    # 1. System packages
    # ---------------------------------------------------------------
    apt-get update -qq && apt-get install -y --no-install-recommends \
        wget curl git unzip zip bzip2 ca-certificates \
        build-essential gfortran cmake ninja-build \
        libz-dev libbz2-dev liblzma-dev libcurl4-openssl-dev \
        libssl-dev libxml2-dev libfontconfig1-dev \
        libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        libgit2-dev libssh2-1-dev \
        libhdf5-dev libnetcdf-dev \
        libgsl-dev libboost-all-dev libglpk-dev \
        perl \
        locales tzdata \
        procps htop less tree \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    # ---------------------------------------------------------------
    # 2. Quarto CLI (standalone binary — not an R package)
    # ---------------------------------------------------------------
    QUARTO_VERSION="1.5.57"
    wget -q \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" \
        -O /tmp/quarto.deb
    dpkg -i /tmp/quarto.deb
    rm /tmp/quarto.deb
    quarto check

    # ---------------------------------------------------------------
    # 3. R packages: Bioconductor + CRAN (pre-installed in image)
    #    Per-project packages managed by renv on the host (bind-mount)
    # ---------------------------------------------------------------
    Rscript /opt/renv_setup.R

    # ---------------------------------------------------------------
    # 4. Permissions
    # ---------------------------------------------------------------
    chmod -R a+rX /usr/local/bin/

%files
    # Files must exist at build time relative to the build context (repo root)
    container/renv_setup.R     /opt/renv_setup.R

%runscript
    echo "R-only bioinformatics container (RStudio Server + Quarto)"
    echo ""
    echo "Usage:"
    echo "  RStudio Server:  ./scripts/run_rstudio.sh"
    echo "  Shell:           ./scripts/run_shell.sh"
    echo "  or:              singularity shell bioinfo_latest.sif"

%test
    # Smoke tests executed at build time with 'singularity build --test'
    echo "=== Smoke Tests ==="
    R --version | head -1
    quarto --version
    Rscript -e 'library(Seurat); cat("Seurat OK\n")'
    Rscript -e 'library(scran); cat("scran OK\n")'
    Rscript -e 'library(clusterProfiler); cat("clusterProfiler OK\n")'
    Rscript -e 'library(targets); library(tarchetypes); cat("targets OK\n")'
    echo "=== All smoke tests passed ==="
