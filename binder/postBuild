#!/bin/bash
# postBuild — executed by repo2docker after conda environment install
#
# Installs R packages using Posit Package Manager (pre-built binaries for Ubuntu Jammy).
# Binary packages are critical: compiling DESeq2 from source takes 20+ min
# and will exceed mybinder.org's build time budget.
#
# Scope: analysis-tier packages only (count matrix → results).
# No alignment, variant calling, or large genome database packages.
#
# Note: postBuild runs as the unprivileged 'jovyan' user — no sudo available.
# R packages must be installed into a user-writable directory.

set -euo pipefail

# ---------------------------------------------------------------
# 1. Create a user-writable R library and point R to it
#    /usr/local/lib/R/site-library is owned by root and not writable.
# ---------------------------------------------------------------
R_LIBS_DIR="${HOME}/R/library"
mkdir -p "${R_LIBS_DIR}"
export R_LIBS_USER="${R_LIBS_DIR}"

# Persist R_LIBS_USER for interactive sessions inside the container
echo "R_LIBS_USER=${R_LIBS_DIR}" >> "${HOME}/.Renviron"

# ---------------------------------------------------------------
# 2. Install R packages via Posit Package Manager (binary builds)
# ---------------------------------------------------------------
Rscript - <<RSCRIPT
# User library is set via R_LIBS_USER env var above; R picks it up automatically.
lib <- Sys.getenv("R_LIBS_USER")
cat("Installing R packages into:", lib, "\n")

options(
  repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/2024-10-28"),
  Ncpus = 2,
  warn  = 1
)

# BiocManager — must be first
if (!requireNamespace("BiocManager", quietly = TRUE)) {
  install.packages("BiocManager", lib = lib)
}
library(BiocManager)
BiocManager::install(version = "3.18", ask = FALSE, update = FALSE, lib = lib)

# CRAN packages
cran_pkgs <- c(
  # Tidyverse
  "tidyverse", "ggplot2", "dplyr", "tidyr", "ggrepel",
  "patchwork", "pheatmap", "RColorBrewer", "viridis",
  # Workflow & reproducibility
  "targets", "tarchetypes", "crew",
  # Reporting / interactivity
  "rmarkdown", "knitr", "quarto", "DT", "jsonlite",
  # Utilities
  "here", "BiocParallel"
)
install.packages(cran_pkgs, lib = lib, ask = FALSE)

# Bioconductor — analysis tier only
bioc_pkgs <- c(
  # Bulk RNA-seq
  "DESeq2", "edgeR", "limma", "tximport",
  # Single-cell R
  "SingleCellExperiment", "scran", "scater",
  # Enrichment / pathway
  "clusterProfiler", "fgsea", "enrichplot",
  "org.Hs.eg.db", "org.Mm.eg.db",
  # Visualization
  "ComplexHeatmap", "EnhancedVolcano"
)
BiocManager::install(bioc_pkgs, lib = lib, ask = FALSE, update = FALSE)

cat("R packages installed successfully.\n")
RSCRIPT

# ---------------------------------------------------------------
# 3. Install Quarto CLI into ~/bin (no sudo needed)
# ---------------------------------------------------------------
QUARTO_VERSION="1.5.57"
mkdir -p "${HOME}/bin"

wget -q \
    "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
    -O /tmp/quarto.tar.gz
tar -xzf /tmp/quarto.tar.gz -C "${HOME}/bin" --strip-components=1
rm /tmp/quarto.tar.gz

# Add ~/bin to PATH for this session and future sessions
export PATH="${HOME}/bin:${PATH}"
echo 'export PATH="${HOME}/bin:${PATH}"' >> "${HOME}/.bashrc"

quarto --version

# ---------------------------------------------------------------
# 4. Register the conda Python kernel in JupyterLab
# ---------------------------------------------------------------
python -m ipykernel install --user \
    --name notebook \
    --display-name "Python (bioinfo-lite)"

echo "postBuild complete."
