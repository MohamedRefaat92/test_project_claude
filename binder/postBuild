#!/bin/bash
# postBuild — executed by repo2docker after conda environment install
#
# R and R packages are now installed via conda (environment.yml).
# This script handles only tasks that conda cannot:
#   - Quarto CLI binary
#   - Jupyter kernel registration
#
# Note: postBuild runs as the unprivileged 'jovyan' user — no sudo available.

set -euo pipefail

# ---------------------------------------------------------------
# 1. Install Quarto CLI into ~/bin (no sudo needed)
# ---------------------------------------------------------------
QUARTO_VERSION="1.5.57"
mkdir -p "${HOME}/bin"

wget -q \
    "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
    -O /tmp/quarto.tar.gz
tar -xzf /tmp/quarto.tar.gz -C "${HOME}/bin" --strip-components=1
rm /tmp/quarto.tar.gz

# Add ~/bin to PATH for this session and future sessions
export PATH="${HOME}/bin:${PATH}"
echo 'export PATH="${HOME}/bin:${PATH}"' >> "${HOME}/.bashrc"

quarto --version

# ---------------------------------------------------------------
# 2. Register Jupyter kernels
# ---------------------------------------------------------------
# Python kernel
python -m ipykernel install --user \
    --name notebook \
    --display-name "Python (bioinfo-lite)"

# R kernel (installed via r-irkernel in environment.yml)
R -e "IRkernel::installspec(user = TRUE, name = 'ir', displayname = 'R (bioinfo-lite)')"

echo "postBuild complete."
